% ---------------------------------------------------------------------------
% Football: referee behaviour and stoppage time
% ---------------------------------------------------------------------------

@article{garicano2005favoritism,
  author       = {Garicano, Luis and Palacios-Huerta, Ignacio and Prendergast, Canice},
  title        = {Favoritism Under Social Pressure},
  journal      = {Review of Economics and Statistics},
  volume       = {87},
  number       = {2},
  pages        = {208--216},
  year         = {2005},
  doi          = {10.1162/0034653053970267},
  provenance   = {peer-reviewed},
  note         = {Referees systematically lengthen stoppage time when the home team is
                  behind and shorten it when ahead, scaling with crowd size. The
                  mediator is score state and social pressure, not team quality --
                  so a naive 'dominant teams get more stoppage time' hypothesis
                  likely inverts once score state is conditioned on. Stoppage time is
                  not available in football-data.co.uk, so this remains untested here.}
}

@article{dohmen2008social,
  author       = {Dohmen, Thomas J.},
  title        = {The Influence of Social Forces: Evidence from the Behavior of
                  Football Referees},
  journal      = {Economic Inquiry},
  volume       = {46},
  number       = {3},
  pages        = {411--424},
  year         = {2008},
  doi          = {10.1111/j.1465-7295.2007.00112.x},
  provenance   = {peer-reviewed},
  note         = {Bundesliga replication of the stoppage-time result, with the
                  running-track/stadium-geometry variation used to separate crowd
                  proximity from crowd size.}
}

% ---------------------------------------------------------------------------
% Correcting public claims: what actually works
% ---------------------------------------------------------------------------

@article{lewandowsky2012misinformation,
  author       = {Lewandowsky, Stephan and Ecker, Ullrich K. H. and Seifert, Colleen M.
                  and Schwarz, Norbert and Cook, John},
  title        = {Misinformation and Its Correction: Continued Influence and
                  Successful Debiasing},
  journal      = {Psychological Science in the Public Interest},
  volume       = {13},
  number       = {3},
  pages        = {106--131},
  year         = {2012},
  doi          = {10.1177/1529100612451018},
  provenance   = {peer-reviewed},
  note         = {The continued-influence effect: a claim keeps shaping inference after
                  it has been corrected, so a correction has to supply a replacement
                  account rather than only a negation.}
}

@article{wood2019backfire,
  author       = {Wood, Thomas and Porter, Ethan},
  title        = {The Elusive Backfire Effect: Mass Attitudes' Steadfast Factual
                  Adherence},
  journal      = {Political Behavior},
  volume       = {41},
  pages        = {135--163},
  year         = {2019},
  doi          = {10.1007/s11109-018-9443-y},
  provenance   = {peer-reviewed},
  note         = {Across 52 issues and roughly 10,100 subjects, corrections moved factual
                  beliefs toward the evidence and backfire was not found. Relevant here
                  as a licence to state findings plainly: the common fear that correcting
                  a claim entrenches it is not well supported.}
}

@techreport{lewandowsky2020handbook,
  author       = {Lewandowsky, Stephan and Cook, John and Lombardi, Doug and others},
  title        = {Debunking Handbook 2020},
  year         = {2020},
  doi          = {10.17910/b7.1182},
  provenance   = {peer-reviewed},
  openaccess   = {yes},
  note         = {Consensus statement of 22 researchers. The operative format rule: lead
                  with the fact, not the claim being corrected, because restating a claim
                  to deny it increases its familiarity. Fact, then the claim with a
                  warning, then why it fails, then the fact again.}
}

